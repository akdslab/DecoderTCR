{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:decodertcr:bundle:2",
    "title": "DecoderTCR immutable bundle manifests",
    "description": "Defines immutable release, dataset, reference-result, and environment manifests. Release schema version 2 supports explicit nonempty subsets of family members. Dataset schema version 2 supports paired sequence-convention views, and version 3 supports raw gene-input CSVs. Schema version 1 remains supported for existing artifacts. This schema validates document structure and field formats. Application checks verify hashes, artifact identities, and model tensor compatibility.",
    "oneOf": [
        {"$ref": "#/$defs/release"},
        {"$ref": "#/$defs/releaseV2"},
        {"$ref": "#/$defs/dataset"},
        {"$ref": "#/$defs/result"},
        {"$ref": "#/$defs/environment"}
    ],
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\.$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "semver": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:+-]*$"},
        "resultIdV2": {
            "allOf": [
                {"$ref": "#/$defs/identity"},
                {"not": {"pattern": "-v[12]$"}}
            ]
        },
        "datasetIdV2": {
            "type": "string",
            "pattern": "^(tcrvdb|exp011|immrep23|viral|viral-public-grid|prp)@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "coreBenchmarkName": {"enum": ["tcrvdb", "exp011", "immrep23", "viral", "viral-public-grid", "prp"]},
        "releaseId": {
            "type": "string",
            "pattern": "^(decodertcr|decodertcr-esm2)@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "modelId": {
            "type": "string",
            "pattern": "^(decodertcr|decodertcr-esm2)@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*):[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "descriptor": {
            "type": "object",
            "properties": {
                "path": {"$ref": "#/$defs/relativePath"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "size_bytes": {"type": "integer", "minimum": 0}
            },
            "required": ["path", "sha256", "size_bytes"],
            "additionalProperties": false
        },
        "license": {
            "type": "object",
            "properties": {
                "name": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
            },
            "required": ["name", "text"],
            "additionalProperties": false
        },
        "weights": {
            "allOf": [
                {"$ref": "#/$defs/descriptor"},
                {"properties": {"path": {"pattern": "\\.safetensors$"}}}
            ]
        },
        "member": {
            "type": "object",
            "properties": {
                "backbone": {"enum": ["esmc", "esm2"]},
                "arch": {
                    "enum": [
                        "DecoderTCRC_300M",
                        "DecoderTCRC_600M",
                        "DecoderTCRC_6B",
                        "ESM2_650M",
                        "ESM2_3B"
                    ]
                },
                "sequence_convention": {"enum": ["v1", "v2"]},
                "weights": {"$ref": "#/$defs/weights"},
                "state_schema_sha256": {"$ref": "#/$defs/sha256"},
                "license": {"$ref": "#/$defs/license"}
            },
            "required": [
                "backbone",
                "arch",
                "sequence_convention",
                "weights",
                "state_schema_sha256",
                "license"
            ],
            "additionalProperties": false
        },
        "recipe": {
            "type": "object",
            "properties": {
                "metric_type": {"enum": ["ranking", "affinity", "context"]},
                "group_key": {"enum": ["peptide", "clone", "cognate_epitope", "offered_peptide"]},
                "score_column": {"const": "pll"},
                "group_column": {"const": "group_id"},
                "recall_ks": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 1},
                    "minItems": 1
                },
                "controls": {"type": "boolean"},
                "dataset_view": {"enum": ["table", "example"]},
                "device": {"type": "string", "minLength": 1},
                "batch_size": {"const": 1},
                "affinity_column": {"type": "string", "minLength": 1},
                "affinity_transform": {"enum": ["identity", "negative_log10"]}
            },
            "required": [
                "metric_type",
                "group_key",
                "score_column",
                "group_column",
                "recall_ks",
                "controls",
                "dataset_view",
                "device",
                "batch_size"
            ],
            "additionalProperties": false
        },
        "tolerances": {
            "type": "object",
            "properties": {
                "atol": {"type": "number", "minimum": 0},
                "rtol": {"type": "number", "minimum": 0}
            },
            "required": ["atol", "rtol"],
            "additionalProperties": false
        },
        "release": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "release"},
                "family": {"enum": ["decodertcr", "decodertcr-esm2"]},
                "version": {"$ref": "#/$defs/semver"},
                "release_id": {"$ref": "#/$defs/releaseId"},
                "created_at": {"type": "string", "format": "date-time"},
                "minimum_package_version": {"$ref": "#/$defs/semver"},
                "inventory_note": {"type": "string"},
                "members": {
                    "type": "object",
                    "additionalProperties": {"$ref": "#/$defs/member"},
                    "minProperties": 1
                }
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "family",
                "version",
                "release_id",
                "created_at",
                "minimum_package_version",
                "inventory_note",
                "members"
            ],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {"properties": {"family": {"const": "decodertcr"}}},
                    "then": {
                        "properties": {
                            "members": {
                                "type": "object",
                                "properties": {
                                    "300M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_300M"}
                                                }
                                            }
                                        ]
                                    },
                                    "600M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_600M"}
                                                }
                                            }
                                        ]
                                    },
                                    "6B": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_6B"}
                                                }
                                            }
                                        ]
                                    }
                                },
                                "required": ["300M", "600M", "6B"],
                                "additionalProperties": false
                            }
                        }
                    }
                },
                {
                    "if": {"properties": {"family": {"const": "decodertcr-esm2"}}},
                    "then": {
                        "properties": {
                            "members": {
                                "type": "object",
                                "properties": {
                                    "650M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esm2"},
                                                    "arch": {"const": "ESM2_650M"}
                                                }
                                            }
                                        ]
                                    },
                                    "3B": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esm2"},
                                                    "arch": {"const": "ESM2_3B"}
                                                }
                                            }
                                        ]
                                    }
                                },
                                "required": ["650M", "3B"],
                                "additionalProperties": false
                            }
                        }
                    }
                }
            ]
        },
        "releaseV2": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 2},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "release"},
                "family": {"enum": ["decodertcr", "decodertcr-esm2"]},
                "version": {"$ref": "#/$defs/semver"},
                "release_id": {"$ref": "#/$defs/releaseId"},
                "created_at": {"type": "string", "format": "date-time"},
                "minimum_package_version": {"$ref": "#/$defs/semver"},
                "inventory_note": {"type": "string"},
                "declared_members": {
                    "type": "array",
                    "items": {"type": "string"},
                    "minItems": 1,
                    "uniqueItems": true
                },
                "members": {
                    "type": "object",
                    "additionalProperties": {"$ref": "#/$defs/member"},
                    "minProperties": 1
                }
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "family",
                "version",
                "release_id",
                "created_at",
                "minimum_package_version",
                "inventory_note",
                "declared_members",
                "members"
            ],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {"properties": {"family": {"const": "decodertcr"}}},
                    "then": {
                        "properties": {
                            "declared_members": {
                                "items": {"enum": ["300M", "600M", "6B"]}
                            },
                            "members": {
                                "type": "object",
                                "properties": {
                                    "300M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_300M"}
                                                }
                                            }
                                        ]
                                    },
                                    "600M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_600M"}
                                                }
                                            }
                                        ]
                                    },
                                    "6B": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esmc"},
                                                    "arch": {"const": "DecoderTCRC_6B"}
                                                }
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                },
                {
                    "if": {"properties": {"family": {"const": "decodertcr-esm2"}}},
                    "then": {
                        "properties": {
                            "declared_members": {
                                "items": {"enum": ["650M", "3B"]}
                            },
                            "members": {
                                "type": "object",
                                "properties": {
                                    "650M": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esm2"},
                                                    "arch": {"const": "ESM2_650M"}
                                                }
                                            }
                                        ]
                                    },
                                    "3B": {
                                        "allOf": [
                                            {"$ref": "#/$defs/member"},
                                            {
                                                "properties": {
                                                    "backbone": {"const": "esm2"},
                                                    "arch": {"const": "ESM2_3B"}
                                                }
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                }
            ]
        },
        "datasetLegacy": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "dataset"},
                "dataset_id": {"$ref": "#/$defs/identity"},
                "benchmark_name": {
                    "enum": [
                        "tcrvdb",
                        "tcrvdb_germline",
                        "prp",
                        "chris",
                        "exp010",
                        "exp011",
                        "immrep23",
                        "immrep25",
                        "viral",
                        "viral_grid_v1only",
                        "iedb_kd",
                        "kd_stitchr",
                        "kd_ecto",
                        "garcia"
                    ]
                },
                "sequence_convention": {"enum": ["v1", "v2"]},
                "table": {"$ref": "#/$defs/descriptor"},
                "example": {"$ref": "#/$defs/descriptor"},
                "exclusions": {"$ref": "#/$defs/descriptor"},
                "raw": {"type": "array", "items": {"$ref": "#/$defs/descriptor"}, "minItems": 1},
                "n_rows": {"type": "integer", "minimum": 1},
                "n_source_rows": {"type": "integer", "minimum": 1},
                "n_excluded_source_rows": {"type": "integer", "minimum": 0},
                "group_key": {"enum": ["peptide", "clone", "cognate_epitope", "offered_peptide"]},
                "metric_type": {"enum": ["ranking", "affinity", "context"]},
                "inventory": {
                    "type": "object",
                    "description": "The reviewed benchmark declaration with mappings, measured source counts, status, and scientific caveats."
                },
                "measured_convention": {
                    "type": "object",
                    "properties": {
                        "verdict": {"enum": ["v1", "v2", "pmhc_inhouse"]},
                        "modal_lengths": {
                            "type": "object",
                            "properties": {
                                "HLA_a": {"type": "integer", "minimum": 0},
                                "TCR_a": {"type": "integer", "minimum": 0},
                                "TCR_b": {"type": "integer", "minimum": 0}
                            },
                            "additionalProperties": false
                        }
                    },
                    "required": ["verdict", "modal_lengths"],
                    "additionalProperties": false
                },
                "preparation": {"const": "complete_population_before_sharding_v1"}
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "dataset_id",
                "benchmark_name",
                "sequence_convention",
                "table",
                "example",
                "exclusions",
                "raw",
                "n_rows",
                "n_source_rows",
                "n_excluded_source_rows",
                "group_key",
                "metric_type",
                "inventory",
                "measured_convention",
                "preparation"
            ],
            "additionalProperties": false
        },
        "datasetView": {
            "type": "object",
            "properties": {
                "sha256": {"$ref": "#/$defs/sha256"},
                "sequence_convention": {"enum": ["v1", "v2"]},
                "table": {"$ref": "#/$defs/descriptor"},
                "example": {"$ref": "#/$defs/descriptor"},
                "exclusions": {"$ref": "#/$defs/descriptor"},
                "raw": {"type": "array", "items": {"$ref": "#/$defs/descriptor"}, "minItems": 1},
                "n_rows": {"type": "integer", "minimum": 1},
                "n_source_rows": {"type": "integer", "minimum": 1},
                "n_excluded_source_rows": {"type": "integer", "minimum": 0},
                "measured_convention": {
                    "$ref": "#/$defs/datasetLegacy/properties/measured_convention"
                }
            },
            "required": [
                "sha256",
                "sequence_convention",
                "table",
                "example",
                "exclusions",
                "raw",
                "n_rows",
                "n_source_rows",
                "n_excluded_source_rows",
                "measured_convention"
            ],
            "additionalProperties": false
        },
        "datasetV2": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 2},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "dataset"},
                "dataset_id": {"$ref": "#/$defs/datasetIdV2"},
                "benchmark_name": {"$ref": "#/$defs/coreBenchmarkName"},
                "group_key": {"$ref": "#/$defs/datasetLegacy/properties/group_key"},
                "metric_type": {"$ref": "#/$defs/datasetLegacy/properties/metric_type"},
                "inventory": {"$ref": "#/$defs/datasetLegacy/properties/inventory"},
                "preparation": {"$ref": "#/$defs/datasetLegacy/properties/preparation"},
                "population_sha256": {
                    "allOf": [{"$ref": "#/$defs/sha256"}],
                    "description": "Order-independent digest of convention-independent biological row identities."
                },
                "views": {
                    "type": "object",
                    "properties": {
                        "v1": {
                            "allOf": [
                                {"$ref": "#/$defs/datasetView"},
                                {"properties": {"sequence_convention": {"const": "v1"}}}
                            ]
                        },
                        "v2": {
                            "allOf": [
                                {"$ref": "#/$defs/datasetView"},
                                {"properties": {"sequence_convention": {"const": "v2"}}}
                            ]
                        }
                    },
                    "required": ["v1", "v2"],
                    "additionalProperties": false
                }
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "dataset_id",
                "benchmark_name",
                "group_key",
                "metric_type",
                "inventory",
                "preparation",
                "population_sha256",
                "views"
            ],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {"properties": {"benchmark_name": {"const": "tcrvdb"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^tcrvdb@"}}}
                },
                {
                    "if": {"properties": {"benchmark_name": {"const": "exp011"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^exp011@"}}}
                },
                {
                    "if": {"properties": {"benchmark_name": {"const": "immrep23"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^immrep23@"}}}
                },
                {
                    "if": {"properties": {"benchmark_name": {"const": "viral"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^viral@"}}}
                },
                {
                    "if": {"properties": {"benchmark_name": {"const": "viral-public-grid"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^viral-public-grid@"}}}
                },
                {
                    "if": {"properties": {"benchmark_name": {"const": "prp"}}},
                    "then": {"properties": {"dataset_id": {"pattern": "^prp@"}}}
                }
            ]
        },
        "datasetRawGene": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 3},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "dataset"},
                "dataset_id": {
                    "enum": ["immrep23-public-inputs@1.0.0", "demo-gene-pairs@1.0.0"]
                },
                "input_format": {"const": "genes"},
                "species": {"const": "human"},
                "artifact": {
                    "allOf": [
                        {"$ref": "#/$defs/descriptor"},
                        {"properties": {"path": {"pattern": "\\.csv$"}}}
                    ]
                },
                "n_rows": {"type": "integer", "minimum": 1},
                "columns": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "minItems": 1,
                    "uniqueItems": true
                },
                "label_column": {"type": "string", "minLength": 1},
                "label_counts": {
                    "type": "object",
                    "properties": {
                        "0": {"type": "integer", "minimum": 0},
                        "1": {"type": "integer", "minimum": 0}
                    },
                    "required": ["0", "1"],
                    "additionalProperties": false
                },
                "usage_column": {
                    "anyOf": [
                        {"type": "string", "minLength": 1},
                        {"type": "null"}
                    ]
                },
                "usage_counts": {
                    "type": "object",
                    "additionalProperties": {"type": "integer", "minimum": 0}
                },
                "source": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string", "minLength": 1},
                        "public_baseline_path": {"$ref": "#/$defs/relativePath"},
                        "citation": {"type": "string", "minLength": 1},
                        "upstream_url": {"type": "string", "format": "uri"},
                        "rights_note": {"type": "string", "minLength": 1}
                    },
                    "required": ["name", "public_baseline_path", "citation", "rights_note"],
                    "additionalProperties": false
                }
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "dataset_id",
                "input_format",
                "species",
                "artifact",
                "n_rows",
                "columns",
                "label_column",
                "label_counts",
                "usage_column",
                "usage_counts",
                "source"
            ],
            "additionalProperties": false
        },
        "dataset": {
            "oneOf": [
                {"$ref": "#/$defs/datasetLegacy"},
                {"$ref": "#/$defs/datasetV2"},
                {"$ref": "#/$defs/datasetRawGene"}
            ]
        },
        "result": {
            "type": "object",
            "properties": {
                "schema_version": {"enum": [1, 2]},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "result"},
                "result_id": {"$ref": "#/$defs/identity"},
                "purpose": {"enum": ["benchmark", "demo"]},
                "model_id": {"$ref": "#/$defs/modelId"},
                "artifact_sha256": {"$ref": "#/$defs/sha256"},
                "dataset_id": {"$ref": "#/$defs/identity"},
                "dataset_sha256": {"$ref": "#/$defs/sha256"},
                "sequence_convention": {"enum": ["v1", "v2"]},
                "dataset_view_sha256": {"$ref": "#/$defs/sha256"},
                "predictions": {"$ref": "#/$defs/descriptor"},
                "metrics": {"$ref": "#/$defs/descriptor"},
                "recipe": {"$ref": "#/$defs/recipe"},
                "expected_metrics": {"type": "object"},
                "tolerances": {"$ref": "#/$defs/tolerances"},
                "environment_id": {"$ref": "#/$defs/identity"},
                "environment_sha256": {"$ref": "#/$defs/sha256"},
                "parent_result_id": {"anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
                "reference_status": {"const": "reference_only"},
                "created_at": {"type": "string", "format": "date-time"},
                "expected_scores": {"$ref": "#/$defs/descriptor"}
            },
            "required": [
                "schema_version",
                "sha256",
                "kind",
                "result_id",
                "purpose",
                "model_id",
                "artifact_sha256",
                "dataset_id",
                "dataset_sha256",
                "predictions",
                "metrics",
                "recipe",
                "expected_metrics",
                "tolerances",
                "environment_id",
                "environment_sha256",
                "parent_result_id",
                "reference_status",
                "created_at"
            ],
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {"properties": {"schema_version": {"const": 2}}},
                    "then": {
                        "required": ["sequence_convention", "dataset_view_sha256"],
                        "properties": {"result_id": {"$ref": "#/$defs/resultIdV2"}}
                    }
                },
                {
                    "if": {"properties": {"purpose": {"const": "demo"}}},
                    "then": {
                        "required": ["expected_scores"],
                        "properties": {
                            "recipe": {"properties": {"dataset_view": {"const": "example"}}}
                        }
                    }
                }
            ]
        },
        "environment": {
            "type": "object",
            "properties": {
                "schema_version": {"const": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
                "kind": {"const": "environment"},
                "environment_id": {"$ref": "#/$defs/identity"},
                "created_at": {"type": "string", "format": "date-time"},
                "python_version": {"type": "string", "minLength": 1},
                "platform": {"type": "string", "minLength": 1},
                "machine": {"type": "string", "minLength": 1},
                "os_release": {"type": "string"},
                "libc": {
                    "type": "array",
                    "items": {"type": "string"},
                    "minItems": 2,
                    "maxItems": 2
                },
                "python_implementation": {"type": "string", "minLength": 1},
                "python_runtime": {"$ref": "#/$defs/descriptor"},
                "uv": {"$ref": "#/$defs/descriptor"},
                "package": {"$ref": "#/$defs/descriptor"},
                "lock": {"$ref": "#/$defs/descriptor"},
